{
  "format": "netsim/1",
  "scenario": {
    "title": "Fix: nobody can visit the home server",
    "group": "fix",
    "order": 14,
    "description": "A friend tries to open the web page on your home server, using your public address. It never arrives.",
    "goal": "Click a device to look at its settings, fix the problem, and send again. \"Show hints\" reveals what the simulator sees.",
    "hideHints": true,
    "suggestions": [
      {
        "label": "Friend → home server (public port 8080)",
        "action": {
          "type": "send",
          "from": "friend",
          "app": "Browser",
          "dstIp": "203.0.113.2",
          "dstPort": 8080,
          "message": "GET /"
        },
        "expect": {
          "delivered": false,
          "reason": "no-mapping",
          "device": "home"
        }
      },
      {
        "label": "PC1 → web server",
        "action": {
          "type": "send",
          "from": "pc1",
          "app": "Browser",
          "dstIp": "203.0.113.80",
          "dstPort": 80,
          "message": "GET /"
        },
        "expect": {
          "delivered": true,
          "replyDelivered": true
        }
      }
    ]
  },
