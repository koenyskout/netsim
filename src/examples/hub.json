{
  "format": "netsim/1",
  "scenario": {
    "title": "2. A hub: everyone hears everything",
    "group": "tour",
    "order": 2,
    "description": "Three computers on a hub. A hub cannot read addresses: it copies every frame out of all its other ports.",
    "goal": "PC1 sends to PC2, but PC3 receives the message too. PC3 compares the destination MAC address with its own and throws the frame away. Send it a second time: the hub has not learned anything, so PC3 gets every frame again. The next step replaces the hub with a switch.",
    "suggestions": [
      {
        "label": "PC1 → PC2",
        "action": {
          "type": "send",
          "from": "pc1",
          "app": "Browser",
          "dstIp": "192.168.1.12",
          "dstPort": 80,
          "message": "GET /"
        },
        "expect": {
          "delivered": true,
          "replyDelivered": true
        }
      },
      {
        "label": "PC3 → PC1",
        "action": {
          "type": "send",
          "from": "pc3",
          "app": "Browser",
          "dstIp": "192.168.1.11",
          "dstPort": 80,
          "message": "GET /"
        },
        "expect": {
          "delivered": true,
          "replyDelivered": true
        }
      }
    ]
  },
