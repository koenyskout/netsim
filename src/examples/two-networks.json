  "scenario": {
    "title": "4. Two networks and a router",
    "group": "tour",
    "order": 4,
    "description": "Two separate networks joined by a router. PC1 and the Server are on different networks, so the message has to go through the router.",
    "goal": "Watch the IP addresses: they never change. Watch the MAC addresses: they change at the router. Click a device to see and change its settings.",
    "suggestions": [
      {
        "label": "PC1 → PC2 (same network)",
        "action": {
          "type": "send",
          "from": "pc1",
          "app": "Chat",
          "dstIp": "192.168.1.11",
          "dstPort": 5000,
          "message": "Hi PC2"
        },
        "expect": {
          "delivered": true,
          "replyDelivered": true
        }
      },
      {
        "label": "PC1 → Server (through the router)",
        "action": {
          "type": "send",
          "from": "pc1",
          "app": "Browser",
          "dstIp": "192.168.2.50",
          "dstPort": 80,
          "message": "GET /"
        },
        "expect": {
          "delivered": true,
          "replyDelivered": true
        }
      }
    ]
  },
