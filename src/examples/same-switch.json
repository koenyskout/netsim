{
  "format": "netsim/1",
  "scenario": {
    "title": "2. Same switch",
    "group": "tour",
    "order": 2,
    "description": "Three computers on one switch. The switch starts out knowing nothing; it learns which MAC address is behind which port.",
    "goal": "PC1 knows PC2's IP address but not its MAC address, so it first asks everyone (ARP). That question is a broadcast, and the switch floods it out of every other port. Meanwhile the switch learns which MAC address is behind which port, so the message itself goes only to the right port. The switch only ever looks at the link layer.",
    "suggestions": [
      {
        "label": "PC1 → PC2 (first time)",
        "action": {
          "type": "send",
          "from": "pc1",
          "app": "Browser",
          "dstIp": "192.168.1.12",
          "dstPort": 80,
          "message": "GET /"
        },
        "expect": {
          "delivered": true,
          "replyDelivered": true
        }
      },
      {
        "label": "PC3 → PC1",
        "action": {
          "type": "send",
          "from": "pc3",
          "app": "Browser",
          "dstIp": "192.168.1.11",
          "dstPort": 80,
          "message": "GET /"
        },
        "expect": {
          "delivered": true,
          "replyDelivered": true
        }
      }
    ]
  },
