{
  "format": "netsim/1",
  "scenario": {
    "title": "6. Getting an address (DHCP)",
    "group": "tour",
    "order": 6,
    "description": "PC1 and PC2 have no IP address yet. They shout \"is there a DHCP server?\" to everybody on their network, and the server hands out an address.",
    "goal": "The question is a broadcast (destination MAC FF:FF:FF:FF:FF:FF), so the switch floods it. A router never forwards a broadcast, so the Far PC on the other side gets no answer.",
    "suggestions": [
      {
        "label": "PC1 asks for an address",
        "action": {
          "type": "dhcp",
          "from": "pc1"
        },
        "expect": {
          "delivered": true
        }
      },
      {
        "label": "PC2 asks for an address",
        "action": {
          "type": "dhcp",
          "from": "pc2"
        },
        "expect": {
          "delivered": true
        }
      },
      {
        "label": "Far PC asks (other network)",
        "action": {
          "type": "dhcp",
          "from": "far"
        },
        "expect": {
          "delivered": false
        }
      },
      {
        "label": "PC1 → web (without an address)",
        "action": {
          "type": "send",
          "from": "pc1",
          "app": "Browser",
          "dstIp": "203.0.113.80",
          "dstPort": 80,
          "message": "GET /"
        },
        "expect": {
          "delivered": false,
          "reason": "no-ip",
          "device": "pc1"
        }
      }
    ]
  },
